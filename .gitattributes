# Normalize line endings in the repository; check out with the platform default
* text=auto

# Windows batch files must use CRLF, otherwise `call :label` / `goto` can fail in cmd.exe
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary

# Not included in release archives created with `git archive`
.github export-ignore
.gitattributes export-ignore
.dockerignore export-ignore
